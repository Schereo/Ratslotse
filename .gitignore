.env
data/
.venv/
__pycache__/
*.pyc
*.sqlite
*.log
.pytest_cache/
.ruff_cache/
web/frontend/.next/
# Eigenes Build-Verzeichnis des Dev-Servers (next.config.mjs) — trennt
# `next dev` von `next build`, die sich sonst .next zerlegen.
web/frontend/.next-dev/
web/frontend/node_modules/

# Vom Browser-Pane geschriebene Dev-Server-Konfig: jede Session trägt hier ihre
# eigenen Ports/Backends ein, das ist Arbeitsstand und kein Repo-Inhalt. Vorlage
# mit den gemeinsamen Einträgen: .claude/launch.example.json (einmal kopieren).
.claude/launch.json

# Persönliche Freigaben und Einstellungen der eigenen Claude-Sitzung.
# Die GETEILTEN Einstellungen stehen in `.claude/settings.json` und sind
# eingecheckt; diese hier ist Arbeitsstand und gehört niemandem sonst.
.claude/settings.local.json

# Lokal installierte Agent-Skills (npx skills add …) — Fremdinhalte, nicht committen
.agents/
.claude/skills/
skills-lock.json

# Vorher/Nachher-Aufnahmen aus der UI-Prüfung: gehören an den Pull Request,
# nicht in die Historie — ein paar Megabyte je Runde.
.screenshots/

# SwiftPM/Xcode-Artefakte der nativen iOS-App
**/.build/
DerivedData/
*.xcresult
xcuserdata/
