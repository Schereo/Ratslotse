{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "web/frontend"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "docs",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--prefix",
        "docs-site"
      ],
      "port": 4321
    },
    {
      "name": "frontend-schere",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "web/frontend"
      ],
      "env": {
        "BACKEND_URL": "http://127.0.0.1:8899",
        "NEXT_PUBLIC_RATSLOTSE_ENV": "dev"
      },
      "port": 3012
    }
  ]
}